# Database
# The default docker-compose.yml runs PostgreSQL + Redis and overrides
# DATABASE_URL/QUEUE_BACKEND in the app service, so you normally don't set
# these by hand. The values below are the single-node (standalone) defaults
# used by docker-compose.standalone.yml and by running the app directly:
#
#   DATABASE_URL=sqlite+aioturso:///data/rss_ripple_turso.db   (embedded Turso)
#   DATABASE_URL=postgresql+asyncpg://rssripple:rssripple@localhost:5432/rssripple
#
# Migrate a Turso database to PostgreSQL with:
#   uv run python scripts/migrate_to_postgres.py \
#       --source sqlite+aioturso:///data/rss_ripple_turso.db \
#       --target postgresql+asyncpg://rssripple:rssripple@localhost:5432/rssripple
DATABASE_URL=sqlite+aioturso:///data/rss_ripple_turso.db

# PostgreSQL service credentials (docker-compose.yml). The app's DATABASE_URL
# is composed from these inside the compose file; override them here to change
# the database user/password/name.
# POSTGRES_USER=rssripple
# POSTGRES_PASSWORD=rssripple
# POSTGRES_DB=rssripple

# Task queue backend: "memory" (single-node) or "redis" (distributed, requires
# REDIS_URL). The default docker-compose.yml sets QUEUE_BACKEND=redis and
# REDIS_URL=redis://redis:6379/0 for you.
# QUEUE_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# LLM (OpenAI-compatible API)
# Default uses OpenRouter free model. Set LLM_API_KEY to your OpenRouter API key.
# Alternatives: google/gemini-2.0-flash-exp:free, meta-llama/llama-3-8b-instruct:free
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1

# Metadata providers (for TVSeries/Movie external ID matching)
# TMDB v3: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Jina Search + Reader API: https://jina.ai/api-dashboard/
# Powers the "jina" metadata source (cheap web-native search, strong CJK coverage).
JINA_API_KEY=
# Exa AI Agent API: https://exa.ai/  (replaces Jina for web search fallback)
EXA_API_KEY=
EXA_EFFORT_LEVEL=low
# Bangumi API token: https://bangumi.github.io/api/
# Powers the "bangumi" metadata source (anime-only) and the post-link
# is_anime verification. Both are enabled simply by setting the token.
BANGUMI_API_KEY=
# Bangumi API base URL (optional, default https://api.bgm.tv/v0). Override for
# a self-hosted mirror or an integration-test mock server.
BANGUMI_API_BASE=

# Metadata source enable switches (optional, default true).
# A source appears as a candidate in the channel form only when enabled AND its
# API key is set (wikipedia needs no key). Set to false to hide a source without
# clearing its key. Env vars: EXA_ENABLED, JINA_ENABLED, TMDB_ENABLED, WIKIPEDIA_ENABLED.
# EXA_ENABLED=true
# JINA_ENABLED=true
# TMDB_ENABLED=true
# WIKIPEDIA_ENABLED=true

# Scheduler
DEFAULT_FETCH_INTERVAL=1800

# Download
MAX_RETRY_COUNT=3
TASK_EXPIRE_DAYS=30

# App
LOG_LEVEL=INFO
DEBUG=false

# Download notifications (webhook fan-out to external consumers; the built-in
# organize subsystem below consumes the same notifications in-process).
# Enabled by default; NOTIFY_ENABLED=false only as a kill switch. Webhooks are
# registered per Agent in the UI (Agent detail → 通知记录 tab). Delivery is
# pure outbound POST, no token, no consumer callback.
# NOTIFY_ENABLED=true
# Delivery retry policy: backoff base * 2^attempt (capped at 30min); after
# NOTIFY_MAX_ATTEMPTS failures the notification is marked failed.
# NOTIFY_MAX_ATTEMPTS=5
# NOTIFY_RETRY_BASE_SECONDS=30
# Retention (days) for consumed ("done") notifications.
# NOTIFY_RETENTION_DAYS=30

# Built-in file organization subsystem (organize): turns download completion
# notifications into file-operation plans targeting scanned Libraries. Always
# on; planning activates as soon as any enabled organize rule exists.
# Media server connection/credentials are stored in the database
# (media_server_instances, managed via /media-servers); legacy PLEX_URL /
# PLEX_TOKEN env vars are converted into one instance row at startup.

# Remote storage volume (docker-compose.yml): SMB/CIFS credentials for the
# vault-storage volume mounted at /storage/vault. Only needed when using the
# built-in file organization with the default compose's CIFS volume.
# SMB_USER=
# SMB_PASSWORD=
# SMB_UID=1000
# SMB_GID=1000
