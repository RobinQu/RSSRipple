+        )
+        db.add(resource)
+        await db.flush()
+        link = ResourceWorkLink(resource_id=resource.id, source="manual", **{kind + "_id": work.id})
+        assignment = ResourceFileAssignment(
+            resource_id=resource.id, file_path="synthetic.mkv", source="manual", **{kind + "_id": work.id}
+        )
