+                    "final_status": "done",
+                    "attempt_count": 0,
+                    "distinct_committed_tokens": True,
+                    "data": "synthetic notification payload",
+                    "mode": mode,
+                    "scope": "independent workers, natural lease recovery, real Redis/PG/HTTP",
