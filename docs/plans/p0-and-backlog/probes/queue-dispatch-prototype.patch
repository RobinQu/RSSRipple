+                agent_id=agent.id,
+                download_task_id=task.id,
+                payload={"version": 2, "notification_id": uid(), "fixture": "synthetic state-race only"},
+            )
+            db.add(notification)
+            await db.flush()
+            delivery = WebhookDelivery(id=uid(), notification_id=notification.id, webhook_id=hook.id)
+            db.add(delivery)
