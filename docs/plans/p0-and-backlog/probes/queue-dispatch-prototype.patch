+async def test_legacy_recovery_cannot_fail_replacement_job(monkeypatch):
+    client = fakeredis.aioredis.FakeRedis(decode_responses=True)
+    queue = RedisQueue(redis_client=client)
+    key = "rssripple:job:legacy-replaced"
