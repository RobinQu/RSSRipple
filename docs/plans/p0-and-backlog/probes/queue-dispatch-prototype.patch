+    async def add_torrent(*args, **kwargs):
+        await client.hset("rssripple:job:rpc-loss", "execution_token", "replacement")
+        if rpc_failed:
+            raise RuntimeError("Old RPC failed after takeover")
+        return {"torrent_id": 1}
+
