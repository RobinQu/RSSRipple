+
+
+@pytest.mark.parametrize('work_fk_turso', ['drift_threshold', 'drift_parentheses'], indirect=True)
+async def test_turso_native_check_drift(work_fk_turso, monkeypatch):
+    await _drift(work_fk_turso[0], monkeypatch)
+
