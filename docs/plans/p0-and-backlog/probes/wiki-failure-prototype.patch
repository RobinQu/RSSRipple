+"""Mandatory PostgreSQL counterpart of the Turso season-evidence matrix."""
+import asyncio
+import json
+import os
+import subprocess
+import sys
+import uuid
+from pathlib import Path
+from urllib.parse import urlsplit, urlunsplit
+
+import asyncpg
+import pytest
+
+
+async def test_wiki_failure_cache_postgres(tmp_path):
+    url = os.environ.get('QUEUE_RECOVERY_POSTGRES_URL')
+    if not url:
+        if os.environ.get('QUEUE_RECOVERY_REQUIRED') == '1':
+            pytest.fail('Metadata failure cache gate requires dedicated PostgreSQL')
+        pytest.skip('Run the isolated integration gate for PostgreSQL')
+    parts = urlsplit(url)
+    assert parts.path == '/queue_recovery'
+    name = 'wiki_failure_' + uuid.uuid4().hex
+    admin = await asyncpg.connect(url)
+    try:
+        await admin.execute(f'CREATE DATABASE "{name}"')
+        output = tmp_path / 'result.json'
+        env = dict(os.environ,
+                   WIKI_FAILURE_DATABASE_URL=urlunsplit(parts._replace(scheme='postgresql+asyncpg', path='/' + name)),
+                   WIKI_FAILURE_RESULT=str(output))
+        result = await asyncio.to_thread(subprocess.run,
+            [sys.executable, '-m', 'tests.integration.metadata.wiki_failure_driver'],
+            cwd=Path(__file__).resolve().parents[3], env=env,
+            capture_output=True, text=True, timeout=120)
+        (tmp_path / 'driver.log').write_text(result.stdout + result.stderr)
+        assert result.returncode == 0, result.stdout + result.stderr
+        assert len(json.loads(output.read_text())['cases']) == 8
+    finally:
+        await admin.execute(f'DROP DATABASE IF EXISTS "{name}" WITH (FORCE)')
+        await admin.close()
--- a/docs/design/business-logic.md
+++ b/docs/design/business-logic.md
@@ -855,3 +855,9 @@
 候选扩展前记录作品季号和合集，写保护后重读值若不同则拒绝旧候选。直接 apply 返回 409；后台刷新返回 found=false、scope_changed=true、applied=[]，不标为 identity_conflict。作品已删除继续按未找到处理。这只验证当前应用调用期间的归属变化，不替代跨请求 preview/apply 的版本契约。
 
 人工映射与已链接资源的 Agent 短路返回必须携带协调后的 season、episode 和 season_ambiguous，避免返回状态与持久化资源不一致。已由 torrent inspection 识别为 franchise 的资源保留合集/文件指派，不再执行整包标题的单作品匹配。
+
+维基来源失败候选契约：所有搜索变体失败时，LLM 的未命中不构成可靠负结果。页面请求的失败字典和异常均保留 source_errors；明确 Page not found 与瞬态请求失败分开。后续 ReAct 未命中保留先前不完整查询的瞬态状态，不写负缓存；成功结果不因先前失败被降级。当前候选仍待双库和完整门禁验证。
+
+TMDB 双语言搜索保留失败与空响应区别：不完整搜索无候选时抛出来源错误，工具层 success=false；有可用候选则返回候选，但不缓存不完整结果。成功双语言空响应可缓存；取消信号继续传播。
+
