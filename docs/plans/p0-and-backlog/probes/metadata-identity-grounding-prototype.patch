+"""Validate model-selected TMDB identity against successful tool results."""
+import json
+import re
+
+from langchain_core.messages import ToolMessage
+
+
+def ground_tmdb_identity(finalize: dict, messages: list) -> dict:
+    if not finalize.get("found"):
+        return finalize
+    identities: set[tuple[str, str]] = set()
+    for message in messages:
+        if not isinstance(message, ToolMessage) or message.name not in {"search_tmdb", "get_tmdb_details"}:
+            continue
+        if message.status == "error" or not isinstance(message.content, str):
+            continue
+        try:
+            payload = json.loads(message.content)
+        except (ValueError, TypeError):
+            continue
+        if not isinstance(payload, dict) or payload.get("success") is not True:
+            continue
+        data = payload.get("data")
+        rows = data if isinstance(data, list) else [data]
+        for row in rows:
+            if not isinstance(row, dict) or row.get("media_type") not in {"tv", "movie"}:
+                continue
+            raw_id = row.get("tmdb_id")
+            if raw_id is None:
+                external_id = row.get("external_id")
+                if isinstance(external_id, str) and re.fullmatch(r"tmdb:[0-9]+", external_id):
+                    raw_id = external_id[5:]
+            if isinstance(raw_id, bool) or not isinstance(raw_id, (int, str)):
+                continue
+            if re.fullmatch(r"[0-9]+", str(raw_id)) and int(raw_id) > 0:
+                identities.add((row["media_type"], str(int(raw_id))))
+    entity = finalize.get("matched_entity")
+    external_id = entity.get("external_id") if isinstance(entity, dict) else None
+    match = re.fullmatch(r"tmdb:([0-9]+)", external_id) if isinstance(external_id, str) else None
+    identity = (finalize.get("content_type"), str(int(match[1]))) if match else None
+    if identity not in identities:
+        return {**finalize, "found": False, "matched_entity": None,
+                "reason": "No matching TMDB identity and media type in tool evidence"}
+    return finalize
