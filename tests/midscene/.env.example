# Midscene model configuration — copy to `.env` (same directory) and fill in.
# The Midscene CLI loads `.env` from the current working directory automatically.
#
# OpenAI-compatible endpoint. Midscene needs a multimodal (vision) model for UI
# grounding; declare the model family so Midscene picks the right prompting
# strategy (see https://midscenejs.com/model-common-config).
MIDSCENE_MODEL_BASE_URL="https://api.kimi.com/coding/v1"
MIDSCENE_MODEL_API_KEY="sk-..."
MIDSCENE_MODEL_NAME="k3"
MIDSCENE_MODEL_FAMILY="kimi3"

# Optional: point the tests at a non-default RSSRipple instance.
# RSSRIPPLE_URL="http://localhost:9001"

# Optional: RSS feed URL used by channel lifecycle tests (must be reachable and
# contain downloadable enclosures/torrent links for resource assertions).
# RSSRIPPLE_TEST_FEED_URL="https://rss.art19.com/apology-line"
